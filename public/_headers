# Cloudflare Pages response headers.
#
# Pages already serves everything in /public from its CDN edge; what was
# missing was caching, so a returning visitor refetched the scene art every
# time and a slow leg of that fetch showed as a layer popping in late. These
# rules let the browser and the edge hold onto the art instead.
#
# A new deployment gives every file a fresh ETag, so a long max-age never
# pins a stale asset past a redeploy: the browser revalidates and the edge
# already has the new bytes.

# Fingerprinted build output (Vite hashes the name): safe to keep forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The driving scene. The app appends a content version to every scene URL
# (?v=<hash>, from prepare-scene.mjs), so a changed layer is a new URL and the
# files can be held forever: the browser only refetches when the art changes.
/scene/*
  Cache-Control: public, max-age=31536000, immutable

# The Marvel Multiverse Atlas mount. Its CSS and JS filenames are stable
# rather than content-hashed (it is a hand-written static app, not Vite
# output), so it gets a revalidating cache instead of `immutable` — long
# enough that a returning visitor does not refetch, short enough that a
# corrected dataset is not pinned behind a year-long max-age.
/marvelmultiverseatlas/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/marvelmultiverseatlas/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Horn samples, the social card and the favicon: same deal.
/horns/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/opengraph.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
